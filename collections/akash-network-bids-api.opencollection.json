{
  "opencollection": "1.0.0",
  "info": {
    "name": "Akash Console Bids API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bids",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List bids for a deployment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://console-api.akash.network/v1/bids",
            "params": [
              {
                "name": "dseq",
                "value": "",
                "type": "query",
                "description": "Deployment sequence identifier."
              }
            ]
          },
          "docs": "Returns bids placed by providers for a given deployment sequence."
        }
      ]
    }
  ],
  "bundled": true
}